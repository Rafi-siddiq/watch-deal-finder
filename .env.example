# --- Reddit API (optional): lets the scanner remove deleted/removed/sold posts ---
# Create a "script" app at https://www.reddit.com/prefs/apps. client_id is the string under
# the app name; client_secret is the "secret" field. Without these, quiet posts are only labeled "may be sold".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- eBay (developer.ebay.com -> your app keyset, PRODUCTION keys) ---
# Client ID = "App ID", Client Secret = "Cert ID".
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_cert_id

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Dashboard PIN gate ---
DASHBOARD_PIN=1234

# --- Budget: your available capital right now (whole dollars) ---
# Deals price <= this are flagged withinBudget:true; over-budget deals are still
# shown, just flagged. Leave unset/blank for no budget constraint (all in-budget).
MAX_PURCHASE_PRICE=1000

# --- Optional: protect the cron endpoint ---
# If set, /api/cron/scan-deals requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends this automatically when CRON_SECRET is configured.
CRON_SECRET=


# --- Reddit deal floor: minimum est. net profit (dollars) for a "fresh" deal alert ---
MIN_NET_PROFIT=300

# --- Personal-collection picks: max price (under-40mm watches priced 10%+ under comps) ---
COLLECTION_MAX_PRICE=2000

# --- Claude AI review (optional): a second look at every new/changed deal ---
# Get a key at https://platform.claude.com. Without it, deals are shown unreviewed.
ANTHROPIC_API_KEY=
# Model for reviews (default claude-haiku-5-5, a fraction of a cent each). claude-opus-5-5 is more careful, ~40x the cost.
AI_MODEL=
# Hard monthly cap on review spend in dollars (default 2). Reviews pause until next month once reached.
AI_MONTHLY_BUDGET=
