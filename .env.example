# --- Reddit (script-type app: https://www.reddit.com/prefs/apps) ---
# Create a "script" app. client_id is the string under the app name;
# client_secret is the "secret" field. username/password are YOUR reddit login.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=watch-deal-finder/1.0 by u/your_reddit_username

# --- eBay (developer.ebay.com -> your app keyset, PRODUCTION keys) ---
# Client ID = "App ID", Client Secret = "Cert ID".
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_cert_id

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Dashboard PIN gate ---
DASHBOARD_PIN=1234

# --- Budget: your available capital right now (whole dollars) ---
# Deals price <= this are flagged withinBudget:true; over-budget deals are still
# shown, just flagged. Leave unset/blank for no budget constraint (all in-budget).
MAX_PURCHASE_PRICE=1000

# --- Optional: protect the cron endpoint ---
# If set, /api/cron/scan-deals requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends this automatically when CRON_SECRET is configured.
CRON_SECRET=
